@model SisPH.Entidades.Entidades.Residente
@{
    ViewData["Title"] = "Historial de Ocupación";
}

<div class="sisph-card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(Model.Foto))
            {
                <img src="@Model.Foto" alt="Foto" class="rounded-circle" style="width:64px;height:64px;object-fit:cover;" />
            }
            <div>
                <h1 class="h5 fw-bold text-sisph mb-0">@Model.NombreCompleto()</h1>
                <div class="small text-muted">Cédula: @Model.Cedula · Correo: @Model.Correo · Tel: @(Model.Telefono ?? "N/D")</div>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Volver</a>
    </div>

    <h2 class="h6 fw-bold text-sisph mt-4 mb-2">Historial de Ocupación en Unidades</h2>
    <div class="table-responsive">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light">
                <tr>
                    <th>Torre</th>
                    <th>Unidad</th>
                    <th>Rol en unidad</th>
                    <th>Fecha inicio</th>
                    <th>Fecha fin</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Ocupaciones.OrderByDescending(x => x.FechaInicio))
                {
                    <tr>
                        <td>@o.Unidad?.Torre?.Nombre</td>
                        <td>@o.Unidad?.Numero</td>
                        <td>@o.Tipo</td>
                        <td>@o.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@(o.FechaFin?.ToString("dd/MM/yyyy") ?? "Actual")</td>
                        <td><partial name="_BadgeEstado" model="@(o.EstaVigente() ? "Vigente" : "Cerrada")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>