@using SisPH.Entidades.Entidades
@using SisPH.Entidades.Enums
@{
    ViewData["Title"] = "Registrar Residente";
    var unidades = ViewBag.Unidades as List<Unidad> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sisph-card p-4">
            <h1 class="h5 fw-bold text-sisph mb-3">Registrar Residente y Asignar Unidad</h1>

            <form asp-action="Crear" method="post" enctype="multipart/form-data">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Cédula / Pasaporte</label>
                        <input type="text" name="cedula" class="form-control" required maxlength="20" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Nombre</label>
                        <input type="text" name="nombre" class="form-control" required maxlength="60" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Apellido</label>
                        <input type="text" name="apellido" class="form-control" required maxlength="60" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Correo electrónico</label>
                        <input type="email" name="correo" class="form-control" required maxlength="120" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Teléfono</label>
                        <input type="text" name="telefono" class="form-control" maxlength="20" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Unidad asignada</label>
                        <select name="unidadId" class="form-select" required>
                            <option value="">-- Selecciona una unidad --</option>
                            @foreach (var u in unidades)
                            {
                                <option value="@u.Id">@u.Torre?.Nombre - Apto. @u.Numero (Piso @u.Piso)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Tipo de ocupación</label>
                        <select name="tipoOcupacion" class="form-select" asp-items="Html.GetEnumSelectList<TipoOcupacion>()"></select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Fotografía (opcional, máx. 2 MB · JPG/PNG/WEBP)</label>
                    <input type="file" name="foto" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" name="crearUsuarioPortal" value="true" id="chkPortal" checked />
                    <label class="form-check-label small" for="chkPortal">
                        Crear usuario de acceso al Portal del Residente (genera contraseña temporal)
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sisph">Guardar residente</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>