@model IEnumerable<SisPH.Entidades.Entidades.Residente>
@{
    ViewData["Title"] = "Residentes";
    string filtro = ViewBag.FiltroActual ?? "activos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold text-sisph mb-1">Residentes y Ocupación</h1>
        <p class="text-muted small mb-0">Propietarios e inquilinos asignados a unidades (CU-04)</p>
    </div>
    <a asp-action="Crear" class="btn btn-sisph">+ Registrar residente</a>
</div>

<div class="sisph-card p-3 mb-3">
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" asp-route-filtro="activos" class="btn @(filtro == "activos" ? "btn-sisph" : "btn-outline-secondary")">Activos</a>
        <a asp-action="Index" asp-route-filtro="inactivos" class="btn @(filtro == "inactivos" ? "btn-sisph" : "btn-outline-secondary")">Inactivos</a>
        <a asp-action="Index" asp-route-filtro="todos" class="btn @(filtro == "todos" ? "btn-sisph" : "btn-outline-secondary")">Todos</a>
    </div>
</div>

<div class="sisph-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Residente</th>
                    <th>Cédula</th>
                    <th>Contacto</th>
                    <th>Unidad vigente</th>
                    <th>Portal</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var oc = r.Ocupaciones.FirstOrDefault();
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(r.Foto))
                                {
                                    <img src="@r.Foto" alt="Foto" class="rounded-circle" style="width:36px;height:36px;object-fit:cover;" />
                                }
                                <span class="fw-semibold">@r.NombreCompleto()</span>
                            </div>
                        </td>
                        <td>@r.Cedula</td>
                        <td class="small">@r.Correo<br /><span class="text-muted">@r.Telefono</span></td>
                        <td class="small">
                            @if (oc?.Unidad != null)
                            {
                                <strong>@oc.Unidad.Torre?.Nombre - @oc.Unidad.Numero</strong>
                                <span class="badge badge-soft-neutral ms-1">@oc.Tipo</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin ocupación vigente</span>
                            }
                        </td>
                        <td>
                            @if (r.UsuarioId.HasValue)
                            {
                                <span class="badge badge-soft-info">Con acceso</span>
                            }
                            else
                            {
                                <span class="text-muted small">Sin usuario</span>
                            }
                        </td>
                        <td><partial name="_BadgeEstado" model="@(r.Activo ? "Activo" : "Inactivo")" /></td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">Historial</a>
                            <a asp-action="Editar" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            @if (r.Activo)
                            {
                                <form asp-action="DarDeBaja" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Baja</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>