@model SisPH.Negocio.Interfaces.EstadoCuentaResidenteDto?
@{
    ViewData["Title"] = "Mi Estado de Cuenta";
}

<div class="mb-4">
    <h1 class="h4 fw-bold text-sisph mb-1">Portal del Residente · Mi Estado de Cuenta</h1>
    <p class="text-muted small mb-0">Consulta tu estatus financiero, cuotas mensuales y recibos digitales firmados con QR (CU-15)</p>
</div>

@if (Model is null)
{
    <div class="alert alert-warning">
        Tu cuenta de usuario aún no tiene un perfil de residente activo asociado. Contacta a la administración.
    </div>
}
else
{
    <div class="sisph-card p-4 mb-4 @(Model.EstaPazYSalvo ? "border-success" : "border-danger")" style="border-width: 2px;">
        <div class="row g-3 align-items-center">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="h5 fw-bold text-sisph mb-0">@Model.Residente.NombreCompleto()</h2>
                    @if (Model.EstaPazYSalvo)
                    {
                        <partial name="_BadgeEstado" model="@("A paz y salvo")" />
                    }
                    else
                    {
                        <partial name="_BadgeEstado" model="@("Morosa")" />
                    }
                </div>
                <div class="small text-muted">
                    @if (Model.UnidadVigente is not null)
                    {
                        <span>
                            Unidad vigente: <strong>@Model.UnidadVigente.Torre?.Nombre · Unidad @Model.UnidadVigente.Numero</strong>
                            (Piso @Model.UnidadVigente.Piso · Coeficiente @Model.UnidadVigente.Coeficiente.ToString("0.####")%)
                        </span>
                    }
                    else
                    {
                        <span>Sin unidad vigente asignada actualmente.</span>
                    }
                </div>
            </div>
            <div class="col-md-5 text-md-end">
                @if (Model.EstaPazYSalvo && Model.TotalAdeudado <= 0)
                {
                    <div class="small text-muted">Estatus de cuenta</div>
                    <div class="fs-4 fw-bold text-success">Al día · A paz y salvo</div>
                }
                else
                {
                    <div class="small text-muted">Total adeudado</div>
                    <div class="fs-3 fw-bold @(Model.EstaPazYSalvo ? "text-warning" : "text-danger")">
                        $@Model.TotalAdeudado.ToString("N2")
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="sisph-card p-3 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold text-sisph">Pase de Visita QR</div>
                    <div class="small text-muted">Vigencia hasta 24 h</div>
                </div>
                <a asp-controller="Pases" asp-action="Crear" class="btn btn-sm btn-sisph">Generar QR</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sisph-card p-3 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold text-sisph">Áreas Sociales</div>
                    <div class="small text-muted">Disponibilidad y galería</div>
                </div>
                <a asp-controller="Reservas" asp-action="Solicitar" class="btn btn-sm btn-sisph">Solicitar</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="sisph-card p-3 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-bold text-sisph">Incidencias</div>
                    <div class="small text-muted">Reportar mantenimiento</div>
                </div>
                <a asp-controller="Incidencias" asp-action="Reportar" class="btn btn-sm btn-sisph">Reportar</a>
            </div>
        </div>
    </div>

    <div class="sisph-card overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold text-sisph mb-0">Cuotas de Mi Unidad</h2>
            <span class="small text-muted">@Model.Cuotas.Count cuota(s) registrada(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Período</th>
                        <th>Tipo</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">Recargo</th>
                        <th class="text-end">Pagado</th>
                        <th class="text-end">Saldo</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cuotas.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No tienes cuotas emitidas todavía.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model.Cuotas)
                        {
                            var pagado = c.PagoDetalles.Sum(pd => pd.MontoAplicado);
                            var saldo = Math.Max(0m, (c.Monto + c.Recargo) - pagado);
                            <tr>
                                <td class="fw-semibold">@c.Periodo</td>
                                <td class="small">@c.Tipo</td>
                                <td class="small">@c.Vence.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">$@c.Monto.ToString("N2")</td>
                                <td class="text-end text-muted">$@c.Recargo.ToString("N2")</td>
                                <td class="text-end text-success">$@pagado.ToString("N2")</td>
                                <td class="text-end fw-bold @(saldo > 0 ? "text-danger" : "text-success")">$@saldo.ToString("N2")</td>
                                <td><partial name="_BadgeEstado" model="c.Estado.ToString()" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="sisph-card overflow-hidden">
        <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
            <h2 class="h6 fw-bold text-sisph mb-0">Historial de Pagos y Recibos Firmados</h2>
            <span class="small text-muted">@Model.Pagos.Count pago(s)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Recibo #</th>
                        <th>Fecha</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th>Cuotas aplicadas</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">Comprobante</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Pagos.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No tienes pagos registrados todavía.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in Model.Pagos)
                        {
                            var periodos = string.Join(", ", p.Detalles.Select(d => d.Cuota?.Periodo ?? $"#{d.CuotaId}"));
                            <tr>
                                <td class="fw-bold">#@p.Id.ToString("D6")</td>
                                <td class="small">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge badge-soft-info">@p.Metodo</span></td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(p.Referencia) ? "—" : p.Referencia)</td>
                                <td class="small">@(string.IsNullOrWhiteSpace(periodos) ? "—" : periodos)</td>
                                <td class="text-end fw-bold text-success">$@p.Monto.ToString("N2")</td>
                                <td class="text-end">
                                    <a asp-controller="Pagos" asp-action="Recibo" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Ver / Imprimir QR
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
