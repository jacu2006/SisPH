@{
    ViewData["Title"] = "Administración de Propiedad Horizontal";
}

<div class="container py-5">
    <div class="row align-items-center g-4 py-3">
        <div class="col-lg-7">
            <span class="badge badge-soft-info mb-2 px-3 py-2">Gestión integral de Propiedad Horizontal</span>
            <h1 class="display-6 fw-bold text-dark mb-3">
                Control financiero, seguridad y trazabilidad en un solo lugar
            </h1>
            <p class="lead text-muted mb-4">
                SisPH centraliza la administración de torres, unidades, cuotas de mantenimiento, recibos firmados digitalmente, reservas de áreas sociales, incidencias y control de visitantes con código QR.
            </p>
            <div class="d-flex gap-2">
                <a asp-controller="Cuenta" asp-action="Login" class="btn btn-sisph btn-lg px-4">Acceder al portal</a>
                <a href="#arquitectura" class="btn btn-outline-secondary btn-lg px-4">Conocer seguridad</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="sisph-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                    <span class="fw-bold text-sisph">Estado de integridad del sistema</span>
                    <span class="badge badge-soft-success">Activo</span>
                </div>
                <ul class="list-unstyled mb-0 small">
                    <li class="mb-2"><strong>Autenticación:</strong> Control de acceso por roles con BCrypt (factor 12).</li>
                    <li class="mb-2"><strong>Firma criptográfica:</strong> Recibos y bitácora protegidos con HMAC-SHA256.</li>
                    <li class="mb-2"><strong>Garita inteligente:</strong> Pases QR temporales con vigencia controlada.</li>
                    <li><strong>Cumplimiento:</strong> Ley 81 de 2019 de Protección de Datos Personales de Panamá.</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-4" id="arquitectura">
        <div class="col-md-6 col-lg-3">
            <div class="sisph-card p-3 h-100">
                <h2 class="h6 fw-bold text-sisph">Seguridad OWASP Top 10</h2>
                <p class="small text-muted mb-0">Protección contra inyección SQL, validación antiforgery y aislamiento de datos por unidad.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="sisph-card p-3 h-100">
                <h2 class="h6 fw-bold text-sisph">Integridad HMAC-SHA256</h2>
                <p class="small text-muted mb-0">Bitácora inmutable y recibos verificables mediante código QR imposible de alterar sin detección.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="sisph-card p-3 h-100">
                <h2 class="h6 fw-bold text-sisph">Trazabilidad Completa</h2>
                <p class="small text-muted mb-0">Auditoría automática de cada pago, mudanza, reserva e incidencia con usuario y fecha exacta.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="sisph-card p-3 h-100">
                <h2 class="h6 fw-bold text-sisph">Portal y Reportes</h2>
                <p class="small text-muted mb-0">Consulta en línea para residentes, exportación a Excel y proyección presupuestaria a 5 años.</p>
            </div>
        </div>
    </div>
</div>