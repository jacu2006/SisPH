@model IEnumerable<SisPH.Entidades.Entidades.Reserva>
@using SisPH.Entidades.Enums
@{
    ViewData["Title"] = "Mis Reservas";
    var lista = Model.ToList();
    var qrs = ViewBag.QrsAprobadas as Dictionary<int, string> ?? new();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold text-sisph mb-1">Mis Reservas de Áreas Sociales</h1>
        <p class="text-muted small mb-0">Consulta tus solicitudes, obtén tu código QR de confirmación o cancela reservas vigentes (CU-08)</p>
    </div>
    <a asp-action="Solicitar" class="btn btn-sisph">+ Solicitar reserva</a>
</div>

<div class="sisph-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Área Social</th>
                    <th>Fecha</th>
                    <th>Horario</th>
                    <th>Estado</th>
                    <th>Observación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (lista.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Aún no tienes reservas registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in lista)
                    {
                        bool puedeCancelar = (r.Estado == EstadoReserva.Solicitada || r.Estado == EstadoReserva.Aprobada)
                            && r.Fecha.Date >= DateTime.Today;
                        <tr>
                            <td class="fw-semibold">@r.AreaSocial?.Nombre</td>
                            <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="small">@r.HoraInicio.ToString(@"hh\:mm") - @r.HoraFin.ToString(@"hh\:mm")</td>
                            <td><partial name="_BadgeEstado" model="r.Estado.ToString()" /></td>
                            <td class="small text-muted">
                                @if (!string.IsNullOrWhiteSpace(r.MotivoRechazo))
                                {
                                    <span class="text-danger">Motivo: @r.MotivoRechazo</span>
                                }
                                else
                                {
                                    <span>Solicitada: @r.FechaSolicitud.ToString("dd/MM/yyyy")</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    @if (r.Estado == EstadoReserva.Aprobada && qrs.ContainsKey(r.Id))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                data-bs-toggle="modal" data-bs-target="#modalQrReserva-@r.Id">
                                            Ver QR
                                        </button>
                                    }
                                    @if (puedeCancelar)
                                    {
                                        <form asp-action="Cancelar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var r in lista.Where(x => x.Estado == EstadoReserva.Aprobada && qrs.ContainsKey(x.Id)))
{
    <div class="modal fade" id="modalQrReserva-@r.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content text-center">
                <div class="modal-header">
                    <h3 class="modal-title h6 fw-bold text-sisph">Reserva #@r.Id Aprobada</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="fw-semibold mb-1">@r.AreaSocial?.Nombre</div>
                    <div class="small text-muted mb-3">
                        @r.Fecha.ToString("dd/MM/yyyy") · @r.HoraInicio.ToString(@"hh\:mm") - @r.HoraFin.ToString(@"hh\:mm")
                    </div>
                    <img src="@qrs[r.Id]"
                         alt="QR Reserva #@r.Id"
                         class="img-fluid border rounded p-2 bg-white"
                         style="max-width: 200px;" />
                </div>
            </div>
        </div>
    </div>
}
