@model IEnumerable<SisPH.Entidades.Entidades.Unidad>
@using SisPH.Entidades.Entidades
@{
    ViewData["Title"] = "Torres y Unidades";
    var torres = ViewBag.Torres as List<Torre> ?? new();
    int? torreSel = ViewBag.TorreSeleccionada;
    decimal sumaGlobalPH = torres.SelectMany(t => t.Unidades).Where(u => u.Activo).Sum(u => u.Coeficiente);
    decimal disponiblePH = Math.Max(0m, 100m - sumaGlobalPH);
    int totalActivasPH = torres.SelectMany(t => t.Unidades).Count(u => u.Activo);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold text-sisph mb-1">Torres y Unidades</h1>
        <p class="text-muted small mb-0">Configuración de apartamentos, metraje y coeficientes de participación (CU-03)</p>
    </div>
    <a asp-action="CrearUnidad" class="btn btn-sisph">+ Nueva unidad</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="sisph-card p-3 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h6 fw-bold text-sisph mb-0">Resumen por Torre y Total Global del PH</h2>
                <span class="badge rounded-pill @(sumaGlobalPH > 100m ? "badge-soft-danger" : "badge-soft-info") px-3 py-1">
                    Global PH: @sumaGlobalPH.ToString("0.####") % / 100 % (@totalActivasPH activas · Disp: @disponiblePH.ToString("0.####") %)
                </span>
            </div>
            <div class="row g-2">
                @foreach (var t in torres)
                {
                    var sumaCoef = t.Unidades.Where(u => u.Activo).Sum(u => u.Coeficiente);
                    <div class="col-md-6">
                        <div class="border rounded p-2 bg-light">
                            <div class="d-flex justify-content-between">
                                <strong>@t.Nombre</strong>
                                <span class="small text-muted">@t.Pisos pisos</span>
                            </div>
                            <div class="small mt-1">
                                Activas: <strong>@t.Unidades.Count(u => u.Activo)</strong> · Coeficiente: <strong>@sumaCoef.ToString("0.####") %</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="sisph-card p-3 h-100">
            <h2 class="h6 fw-bold text-sisph mb-2">Registrar Nueva Torre</h2>
            <form asp-action="CrearTorre" method="post" class="row g-2">
                <div class="col-7">
                    <input type="text" name="nombre" class="form-control form-control-sm" placeholder="Ej. Torre C" required maxlength="50" />
                </div>
                <div class="col-3">
                    <input type="number" name="pisos" class="form-control form-control-sm" placeholder="Pisos" min="1" required />
                </div>
                <div class="col-2">
                    <button type="submit" class="btn btn-sm btn-sisph w-100">+</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="sisph-card p-3 mb-3">
    <form method="get" id="formFiltroTorre" class="d-flex align-items-center gap-2">
        <label for="selectTorre" class="small fw-semibold">Filtrar por torre:</label>
        <select id="selectTorre" name="torreId" class="form-select form-select-sm" style="max-width: 220px;">
            <option value="">Todas las torres</option>
            @foreach (var t in torres)
            {
                <option value="@t.Id" selected="@(torreSel == t.Id)">@t.Nombre</option>
            }
        </select>
    </form>
</div>

<div class="sisph-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Torre</th>
                    <th>Unidad</th>
                    <th>Piso</th>
                    <th>Área (m²)</th>
                    <th>Coeficiente</th>
                    <th>Residente vigente</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var residenteActual = u.Ocupaciones.FirstOrDefault()?.Residente?.NombreCompleto() ?? "Disponible";
                    <tr>
                        <td>@u.Torre?.Nombre</td>
                        <td class="fw-bold">@u.Numero</td>
                        <td>@u.Piso</td>
                        <td>@u.Metros2.ToString("0.00") m²</td>
                        <td>@u.Coeficiente.ToString("0.####") %</td>
                        <td class="small">@residenteActual</td>
                        <td><partial name="_BadgeEstado" model="@(u.Activo ? "Activo" : "Inactivo")" /></td>
                        <td class="text-end">
                            <a asp-action="EditarUnidad" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <input type="hidden" name="activo" value="@(!u.Activo)" />
                                <button type="submit" class="btn btn-sm @(u.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('selectTorre')?.addEventListener('change', () => {
            const form = document.getElementById('formFiltroTorre');
            if (form instanceof HTMLFormElement) {
                form.submit();
            }
        });
    </script>
}