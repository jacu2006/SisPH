@using SisPH.Entidades.Entidades
@{
    ViewData["Title"] = "Nueva Unidad";
    var torres = ViewBag.Torres as List<Torre> ?? new();
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="sisph-card p-4">
            <h1 class="h5 fw-bold text-sisph mb-3">Registrar Nueva Unidad</h1>
            <form asp-action="CrearUnidad" method="post">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Torre</label>
                    <select name="torreId" class="form-select" required>
                        <option value="">-- Selecciona una torre --</option>
                        @foreach (var t in torres)
                        {
                            <option value="@t.Id">@t.Nombre (@t.Pisos pisos)</option>
                        }
                    </select>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Número de unidad</label>
                        <input type="text" name="numero" class="form-control" placeholder="Ej. 12-B" required maxlength="10" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Piso</label>
                        <input type="number" name="piso" class="form-control" min="1" required />
                    </div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Área en m²</label>
                        <input type="number" step="0.01" min="1" name="metros2" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Coeficiente de participación (%)</label>
                        <input type="number" step="0.0001" min="0.0001" max="100" name="coeficiente" class="form-control" required />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sisph">Guardar unidad</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>