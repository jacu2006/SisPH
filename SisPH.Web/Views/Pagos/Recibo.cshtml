@model SisPH.Negocio.Interfaces.ReciboVerificadoDto
@{
    ViewData["Title"] = $"Recibo #{Model.Pago.Id:D6}";
    var pago = Model.Pago;
}

<style>
    @@media print {
        .sisph-sidebar, .sisph-topbar, .no-print {
            display: none !important;
        }
        .sisph-main {
            margin: 0 !important;
            padding: 0 !important;
        }
        body {
            background-color: #ffffff !important;
        }
        .sisph-card {
            border: none !important;
            box-shadow: none !important;
        }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 no-print">
    <div>
        <h1 class="h4 fw-bold text-sisph mb-1">Comprobante Oficial de Pago</h1>
        <p class="text-muted small mb-0">Documento firmado criptográficamente con HMAC-SHA256 y código QR de verificación (RF-13 / CU-20)</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" id="btnImprimirRecibo" class="btn btn-sisph">Imprimir comprobante</button>
        @if (User.IsInRole("Residente"))
        {
            <a asp-controller="Portal" asp-action="Index" class="btn btn-outline-secondary">Volver a mi cuenta</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Volver a pagos</a>
        }
    </div>
</div>

<div class="sisph-card p-4 mx-auto" style="max-width: 820px;">
    <div class="d-flex flex-wrap justify-content-between align-items-start border-bottom pb-3 mb-4 gap-3">
        <div>
            <div class="fs-4 fw-bold text-sisph">SisPH</div>
            <div class="small text-muted">Sistema de Administración de Propiedad Horizontal</div>
            <div class="small text-muted">Recibo Oficial de Pago</div>
        </div>
        <div class="text-md-end">
            <div class="fs-5 fw-bold text-sisph">Recibo #@pago.Id.ToString("D6")</div>
            <div class="small text-muted">Fecha: @pago.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="mt-2">
                @if (Model.FirmaValida)
                {
                    <span class="badge rounded-pill badge-soft-success px-3 py-1">Firma HMAC-SHA256 Válida</span>
                }
                else
                {
                    <partial name="_BadgeEstado" model="@("Alterada")" />
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="border rounded p-3 h-100 bg-light">
                <div class="small text-uppercase text-muted fw-semibold mb-2">Datos de la Unidad</div>
                <div><strong>Torre:</strong> @pago.Unidad?.Torre?.Nombre</div>
                <div><strong>Unidad:</strong> @pago.Unidad?.Numero (Piso @pago.Unidad?.Piso)</div>
                <div><strong>Coeficiente:</strong> @(pago.Unidad?.Coeficiente.ToString("0.####")) %</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded p-3 h-100 bg-light">
                <div class="small text-uppercase text-muted fw-semibold mb-2">Datos de la Transacción</div>
                <div><strong>Método de pago:</strong> @pago.Metodo</div>
                <div><strong>Referencia:</strong> @(string.IsNullOrWhiteSpace(pago.Referencia) ? "N/A" : pago.Referencia)</div>
                <div><strong>Recibido por:</strong> @(pago.Usuario?.Nombre ?? "Administración")</div>
            </div>
        </div>
    </div>

    <h2 class="h6 fw-bold text-sisph mb-2">Desglose de Cuotas Aplicadas</h2>
    <div class="table-responsive mb-4">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Período</th>
                    <th>Tipo de cuota</th>
                    <th>Estado actual</th>
                    <th class="text-end">Monto aplicado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var det in pago.Detalles)
                {
                    <tr>
                        <td class="fw-semibold">@(det.Cuota?.Periodo ?? $"Cuota #{det.CuotaId}")</td>
                        <td>@(det.Cuota?.Tipo.ToString() ?? "—")</td>
                        <td>
                            @if (det.Cuota is not null)
                            {
                                <partial name="_BadgeEstado" model="det.Cuota.Estado.ToString()" />
                            }
                        </td>
                        <td class="text-end fw-semibold">$@det.MontoAplicado.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <th colspan="3" class="text-end">TOTAL PAGADO</th>
                    <th class="text-end fs-5 text-success">$@pago.Monto.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="row g-3 align-items-center border-top pt-3">
        <div class="col-md-8">
            <div class="small fw-semibold text-sisph mb-1">Verificación Criptográfica (HMAC-SHA256)</div>
            <p class="small text-muted mb-2">
                Escanee el código QR para verificar en línea la autenticidad e integridad de este recibo sin iniciar sesión.
            </p>
            <div class="small text-muted font-monospace text-break">
                Firma: @pago.Firma
            </div>
            <div class="mt-2 no-print">
                <a asp-action="Verificar" asp-route-id="@pago.Id" class="small text-decoration-none">
                    Abrir enlace público de verificación →
                </a>
            </div>
        </div>
        <div class="col-md-4 text-center">
            <img src="@Model.QrBase64"
                 alt="Código QR de verificación del recibo #@pago.Id"
                 class="img-fluid border rounded p-2 bg-white"
                 style="max-width: 170px;" />
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnImprimirRecibo')?.addEventListener('click', () => {
            window.print();
        });
    </script>
}
