@model IEnumerable<SisPH.Entidades.Entidades.AreaSocial>
@{
    ViewData["Title"] = "Áreas Sociales";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold text-sisph mb-1">Áreas Sociales</h1>
        <p class="text-muted small mb-0">Espacios comunes, tarifas, horarios y galería con miniaturas de 200 px (CU-05)</p>
    </div>
    <a asp-action="Crear" class="btn btn-sisph">+ Nueva área social</a>
</div>

<div class="row g-3">
    @foreach (var a in Model)
    {
        var principal = a.ImagenPrincipal();
        <div class="col-md-6 col-lg-4">
            <div class="sisph-card h-100 d-flex flex-column overflow-hidden">
                @if (principal != null)
                {
                    var rutaImagen = !string.IsNullOrWhiteSpace(principal.Ruta) ? principal.Ruta : principal.RutaThumbnail;
                    <img src="@rutaImagen" alt="@a.Nombre" class="w-100" style="height: 180px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center text-muted small" style="height: 180px;">
                        Sin imagen cargada
                    </div>
                }
                <div class="p-3 flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h2 class="h6 fw-bold text-sisph mb-0">@a.Nombre</h2>
                        <partial name="_BadgeEstado" model="@(a.Activo ? "Activo" : "Inactivo")" />
                    </div>
                    <p class="small text-muted mb-2">@(a.Descripcion ?? "Sin descripción")</p>
                    <ul class="list-unstyled small mb-0">
                        <li><strong>Capacidad:</strong> @a.Capacidad personas</li>
                        <li><strong>Horario:</strong> @a.HoraApertura.ToString(@"hh\:mm") - @a.HoraCierre.ToString(@"hh\:mm")</li>
                        <li><strong>Costo / Depósito:</strong> $@a.Costo.ToString("0.00") / $@a.Deposito.ToString("0.00")</li>
                    </ul>
                </div>
                <div class="p-3 border-top bg-light d-flex justify-content-between">
                    <a asp-action="Detalle" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">Galería (@a.Imagenes.Count)</a>
                    <div class="d-flex gap-1">
                        <a asp-action="Editar" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@a.Id" />
                            <input type="hidden" name="activo" value="@(!a.Activo)" />
                            <button type="submit" class="btn btn-sm @(a.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(a.Activo ? "Baja" : "Activar")
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>