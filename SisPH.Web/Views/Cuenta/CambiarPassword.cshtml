@model SisPH.Web.Models.CambiarPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    bool cambioObligatorio = User.HasClaim("DebeCambiarPassword", "true");
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="sisph-card p-4">
            <h2 class="h5 fw-bold text-sisph mb-3">Actualizar contraseña</h2>
            @if (cambioObligatorio)
            {
                <div class="alert alert-warning small">
                    Por seguridad, debes establecer una contraseña personal antes de acceder a los demás módulos del sistema.
                </div>
            }
            <form asp-action="CambiarPassword" method="post">
                <div class="mb-3">
                    <label asp-for="ClaveActual" class="form-label small fw-semibold">Contraseña actual</label>
                    <input asp-for="ClaveActual" class="form-control" />
                    <span asp-validation-for="ClaveActual" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ClaveNueva" class="form-label small fw-semibold">Nueva contraseña (mínimo 8 caracteres)</label>
                    <input asp-for="ClaveNueva" class="form-control" />
                    <span asp-validation-for="ClaveNueva" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmarClave" class="form-label small fw-semibold">Confirmar nueva contraseña</label>
                    <input asp-for="ConfirmarClave" class="form-control" />
                    <span asp-validation-for="ConfirmarClave" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-sisph">Guardar cambios</button>
                    @if (!cambioObligatorio)
                    {
                        <a asp-controller="Home" asp-action="Panel" class="btn btn-outline-secondary">Cancelar</a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>