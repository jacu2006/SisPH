@model SisPH.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="sisph-card p-4 shadow-sm">
                <div class="text-center mb-4">
                    <h1 class="h4 fw-bold text-sisph mb-1">SisPH</h1>
                    <p class="text-muted small mb-0">Ingresa tus credenciales para acceder según tu rol</p>
                </div>

                @if (ViewBag.ErrorLogin is string error)
                {
                    <div class="alert alert-danger py-2 small">@error</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label small fw-semibold">Correo electrónico</label>
                        <input asp-for="Correo" class="form-control" placeholder="admin@sisph.com" autocomplete="username" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label small fw-semibold">Contraseña</label>
                        <input asp-for="Contrasena" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-sisph w-100 py-2 fw-semibold">
                        Ingresar al sistema
                    </button>
                </form>

                <div class="mt-3 p-2 rounded bg-light border small text-muted text-center">
                    Acceso protegido. Tras 5 intentos fallidos la cuenta se bloqueará temporalmente por 15 minutos.
                </div>

                <div class="text-center mt-3">
                    <a asp-controller="Home" asp-action="Index" class="small text-decoration-none">← Volver a la página pública</a>
                </div>
            </div>
        </div>
    </div>
</div>