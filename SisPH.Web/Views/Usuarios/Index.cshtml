@model IEnumerable<SisPH.Entidades.Entidades.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    string filtro = ViewBag.FiltroActual ?? "activos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 fw-bold text-sisph mb-1">Gestión de Usuarios</h1>
        <p class="text-muted small mb-0">Administración de cuentas internas y baja lógica (CU-02)</p>
    </div>
    <a asp-action="Crear" class="btn btn-sisph">+ Nuevo usuario</a>
</div>

<div class="sisph-card p-3 mb-3">
    <div class="btn-group btn-group-sm" role="group">
        <a asp-action="Index" asp-route-filtro="activos" class="btn @(filtro == "activos" ? "btn-sisph" : "btn-outline-secondary")">Activos</a>
        <a asp-action="Index" asp-route-filtro="inactivos" class="btn @(filtro == "inactivos" ? "btn-sisph" : "btn-outline-secondary")">Inactivos</a>
        <a asp-action="Index" asp-route-filtro="todos" class="btn @(filtro == "todos" ? "btn-sisph" : "btn-outline-secondary")">Todos</a>
    </div>
</div>

<div class="sisph-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Creación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-semibold">@u.Nombre</td>
                        <td>@u.Correo</td>
                        <td><span class="badge badge-soft-info">@u.Rol?.Nombre</span></td>
                        <td>
                            <partial name="_BadgeEstado" model="@(u.Activo ? "Activo" : "Inactivo")" />
                        </td>
                        <td class="small text-muted">@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <input type="hidden" name="activo" value="@(!u.Activo)" />
                                <button type="submit" class="btn btn-sm @(u.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(u.Activo ? "Dar de baja" : "Reactivar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>